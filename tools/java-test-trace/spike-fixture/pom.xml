<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.codebase.trace</groupId>
    <artifactId>java-test-trace</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>spike-fixture</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.codebase.trace</groupId>
      <artifactId>trace-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -Dtrace.include=example.tracespike.app. -javaagent:${project.basedir}/../trace-agent/target/trace-agent-${project.version}.jar</argLine>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <systemPropertyVariables>
            <trace.enabled>true</trace.enabled>
            <trace.sourceRoot>${project.basedir}</trace.sourceRoot>
            <trace.output>${project.build.directory}/trace-observations.json</trace.output>
            <junit.jupiter.execution.parallel.enabled>true</junit.jupiter.execution.parallel.enabled>
            <junit.jupiter.execution.parallel.config.strategy>fixed</junit.jupiter.execution.parallel.config.strategy>
            <junit.jupiter.execution.parallel.config.fixed.parallelism>2</junit.jupiter.execution.parallel.config.fixed.parallelism>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>finalize-trace</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>dev.codebase.trace.output.TraceArtifactAssembler</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.build.directory}/trace-observations.json</argument>
                <argument>${project.build.directory}/site/jacoco/jacoco.xml</argument>
                <argument>0000000000000000000000000000000000000000</argument>
                <argument>local-java-trace-spike</argument>
                <argument>Synthetic Java 17/Spring Boot 3.3.4 fixture; direct JUnit and synchronous in-JVM HTTP; no arbitrary async propagation</argument>
                <argument>${project.build.directory}/java-test-trace.json</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
